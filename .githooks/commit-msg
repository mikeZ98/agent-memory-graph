#!/usr/bin/env bash
# commit-msg: enforce Conventional Commits, reject meta-trailers and re-validate
# author + committer identity (covers --author, --amend).
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
# shellcheck source=_policy.sh
source "$ROOT/.githooks/_policy.sh"

msg="$(amg_clean_message <"$1")"
subject="$(amg_subject "$msg")"

fail=0
[[ -n "$subject" ]] || { amg_err "Empty commit message."; exit 1; }
amg_check_subject "$subject" || fail=1
amg_check_trailers "$msg" || fail=1
amg_check_current_identity || fail=1

exit "$fail"
