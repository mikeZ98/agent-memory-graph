#!/usr/bin/env bash
# pre-commit: enforce sole-committer identity, block cache/secret files, scan staged
# content for machine paths and credentials, lint staged Python.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
# shellcheck source=_policy.sh
source "$ROOT/.githooks/_policy.sh"

fail=0

amg_check_current_identity || fail=1

# Staged paths that must never be committed.
forbidden_paths="$(git diff --cached --name-only --diff-filter=ACMR |
  grep -E "$AMG_FORBIDDEN_PATH_RE" | grep -vE "$AMG_ALLOWED_PATH_RE" || true)"
if [[ -n "$forbidden_paths" ]]; then
  amg_err "Refusing to commit cache, virtualenv or secret files:"
  sed 's/^/    /' <<<"$forbidden_paths" >&2
  fail=1
fi

# Added lines only; the policy file itself defines the patterns and is exempt.
added_lines="$(git diff --cached -U0 --diff-filter=ACMR -- . ':(exclude).githooks/_policy.sh' |
  grep -E '^\+[^+]' || true)"

path_leaks="$(grep -nE "$AMG_PATH_LEAK_RE" <<<"$added_lines" || true)"
if [[ -n "$path_leaks" ]]; then
  amg_err "Staged changes contain absolute machine paths:"
  sed 's/^/    /' <<<"$path_leaks" >&2
  fail=1
fi

secret_hits="$(grep -nE -- "$AMG_SECRET_RE" <<<"$added_lines" || true)"
if [[ -n "$secret_hits" ]]; then
  amg_err "Staged changes look like they contain credentials:"
  sed -E 's/^([0-9]+):.*/    line \1 of staged diff (content redacted)/' <<<"$secret_hits" >&2
  fail=1
fi

# Ruff on staged Python files (the tools live in the uv venv under .cache/).
# Plain read loop instead of mapfile: stays compatible with macOS /bin/bash 3.2.
py_files=()
while IFS= read -r f; do
  py_files+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.py' '*.pyi')
if ((${#py_files[@]} > 0)); then
  ruff_bin="${UV_PROJECT_ENVIRONMENT:-$ROOT/.cache/venv}/bin/ruff"
  if [[ -x "$ruff_bin" ]]; then
    "$ruff_bin" check --quiet -- "${py_files[@]}" || fail=1
    "$ruff_bin" format --check --quiet -- "${py_files[@]}" || fail=1
  else
    amg_err "ruff not found at $ruff_bin — run 'uv sync' (with direnv loaded)."
    fail=1
  fi
fi

exit "$fail"
